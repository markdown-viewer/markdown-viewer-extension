#!/bin/sh
# Repository baseline validation. Enforces STANDARD.md from HughZadora/repo-template.
#
# This file is byte-identical in every repository by design. Do not edit a copy;
# change the canon in repo-template, run scripts/update-canon-manifest, and roll
# the change out. Read STANDARD.md for the rule behind each check.
#
# POSIX-compatible shell: only standard shell, git, and basic text tools.
# No project runtime (Node, Python, Ruby, jq, yq) is required.
#
# Usage: scripts/repository-check [--strict]
#   --strict  treat warnings as failures (the canon uses this)
#
# Exit status is non-zero when any check fails.
set -eu

# >>> canon-manifest
# Generated by scripts/update-canon-manifest. Do not edit by hand.
# Format: <repository path> <requirement> <canon path> <sha256>
#   all          required everywhere, byte-identical to canon
#   application  required when project.yaml declares type application
#   model        required when project.yaml declares type model
#   optional     if present, must be byte-identical to canon
#   advisory     if present and different, warning only
#@ scripts/repository-check all scripts/repository-check fd23ab873d30ab2a66415cb7276b4ef679cf651d0262b1077612133e9c61ce3b
#@ .editorconfig all .editorconfig bc8c68c97ac4826849466c700b1a009a50449e1db3c7027553b131c9df2ae250
#@ .gitattributes all .gitattributes d60f352d0db1404c70afb4bb8b2ca3fd1c610572aa40720e8a0b7baa7885418c
#@ .markdownlint.yaml all .markdownlint.yaml 00f539730b6ac4bf96c1aa9384ebaaedae188a9f2b4d4362f643594bfc79940b
#@ .github/dependabot.yml all .github/dependabot.yml 9804ed1afdf6b83d6284bf86e24804121fedbd19000ac33dd332960618d00cb7
#@ STANDARD.md all STANDARD.md ead91345a7bc41d20e2469e2889d83c065081365f2582191db9acfee392e8efc
#@ .github/workflows/repository-baseline.yml all .github/workflows/repository-baseline.yml e7fcebf018c6e7d942e86c36aa660f0762d4ad6a82b29528760b2a084aeb1c07
#@ .prettierrc.json application .prettierrc.json d1dc28d81d35d108645c8d83fbf2bb4a9a840265bce8fdb01100e1fe62abeaaf
#@ .prettierignore application .prettierignore e5d4f6658f2cca9634b43a9f695a43cbc66c38e73dbb509e4c3f601889382f98
#@ ruff.toml model ruff.toml cc4683bea34a7e600e2f60720e2f6b749a3945943b7ec0fb51ad806d8a7eb3c4
#@ eslint.config.mjs advisory eslint.config.mjs 13b2dc90db2c7d493788ed109a4af59e1859da5deee5adf1c4f4af4c4be4c5ab
# <<< canon-manifest

strict=0
case "${1:-}" in
  '') ;;
  --strict) strict=1 ;;
  -h|--help)
    printf 'Usage: scripts/repository-check [--strict]\n'
    exit 0 ;;
  *)
    printf 'unknown option: %s\n' "$1" >&2
    exit 2 ;;
esac

failures=0
warnings=0

pass() { printf 'ok: %s\n' "$1"; }
fail_one() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }
warn_one() { printf 'WARN: %s\n' "$1"; warnings=$((warnings + 1)); }

SCRIPT_PATH=$0
case $SCRIPT_PATH in
  /*) ;;
  *) SCRIPT_PATH=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0") ;;
esac

if command -v sha256sum >/dev/null 2>&1; then
  digest() { sha256sum | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
  digest() { shasum -a 256 | cut -d' ' -f1; }
elif command -v openssl >/dev/null 2>&1; then
  digest() { openssl dgst -sha256 | awk '{print $NF}'; }
else
  printf 'FAIL: no SHA-256 tool available (sha256sum, shasum, or openssl)\n'
  exit 1
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf 'FAIL: not inside a git repository\n'
  exit 1
}
cd "$ROOT"

TMP=$(mktemp -d "${TMPDIR:-/tmp}/repository-check.XXXXXX")
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT HUP INT TERM

# --- project.yaml ---------------------------------------------------------
TYPE=
if [ -f project.yaml ]; then
  pass 'project.yaml exists'
  if grep -q "$(printf '\t')" project.yaml; then
    fail_one 'project.yaml contains a tab; use spaces'
  fi
  if grep -Ev '^[a-z_]+: .+$' project.yaml | grep -q .; then
    fail_one 'project.yaml has a line outside the flat key: value schema'
  fi
  for key in version name type purpose status; do
    value=$(sed -n "s/^$key:[[:space:]]*//p" project.yaml | head -1)
    [ -n "$value" ] || fail_one "project.yaml is missing required key $key"
  done
  for key in $(sed -n 's/^\([a-z_]*\):.*/\1/p' project.yaml); do
    case $key in
      version|name|type|purpose|status|validation) ;;
      *) fail_one "project.yaml has unknown key $key" ;;
    esac
  done
  version=$(sed -n 's/^version:[[:space:]]*//p' project.yaml | head -1)
  [ "$version" = "1" ] || fail_one "project.yaml version must be 1, found ${version:-none}"
  TYPE=$(sed -n 's/^type:[[:space:]]*//p' project.yaml | head -1)
  case $TYPE in
    template|application|meta|asset|deploy|firmware|infra|model) pass "project.yaml type $TYPE" ;;
    '') ;;
    *) fail_one "project.yaml type is not a known tier: $TYPE" ;;
  esac
  status=$(sed -n 's/^status:[[:space:]]*//p' project.yaml | head -1)
  case $status in
    active|maintenance|archived) pass "project.yaml status $status" ;;
    '') ;;
    *) fail_one "project.yaml status must be active, maintenance, or archived: $status" ;;
  esac
  name=$(sed -n 's/^name:[[:space:]]*//p' project.yaml | head -1)
  expected_name=$(basename "$ROOT")
  if [ -n "$name" ] && [ "$name" != "$expected_name" ]; then
    fail_one "project.yaml name $name does not match directory $expected_name"
  fi
else
  fail_one 'missing required file project.yaml'
fi

# --- Shared files: byte-identical to canon --------------------------------
sed -n '/^# >>> canon-manifest$/,/^# <<< canon-manifest$/p' "$SCRIPT_PATH" \
  | grep '^#@ ' | sed 's/^#@ //' > "$TMP/manifest"
[ -s "$TMP/manifest" ] || fail_one 'canon manifest is empty; run scripts/update-canon-manifest'

body_hash=$(sed '/^# >>> canon-manifest$/,/^# <<< canon-manifest$/d' "$SCRIPT_PATH" | digest)

while IFS= read -r entry; do
  [ -n "$entry" ] || continue
  path=$(printf '%s' "$entry" | awk '{print $1}')
  requirement=$(printf '%s' "$entry" | awk '{print $2}')
  expected=$(printf '%s' "$entry" | awk '{print $4}')
  [ -n "$path" ] || continue

  case $requirement in
    all|application|model|optional|advisory) ;;
    *) fail_one "manifest entry for $path has unknown requirement $requirement"; continue ;;
  esac

  required=0
  case $requirement in
    all) required=1 ;;
    application) [ "$TYPE" = "application" ] && required=1 ;;
    model) [ "$TYPE" = "model" ] && required=1 ;;
  esac

  if [ ! -f "$path" ]; then
    if [ "$required" -eq 1 ]; then
      fail_one "missing required file $path"
    fi
    continue
  fi

  actual=$(digest < "$path")
  if [ "$path" = "scripts/repository-check" ]; then
    actual=$body_hash
  fi

  if [ "$actual" = "$expected" ]; then
    pass "$path matches canon"
  elif [ "$requirement" = "advisory" ]; then
    warn_one "$path differs from canon (advisory; align it in phase 2)"
  else
    fail_one "$path differs from canon; copy the canon file instead of editing a local variant"
  fi
done < "$TMP/manifest"

# --- .gitignore baseline block -------------------------------------------
# >>> canon baseline
#|.DS_Store
#|.pi/
#|/artifacts/
#|/dist/
#|/build/
#|/coverage/
#|/node_modules/
#|.env
#|.env.*
#|!.env.example
#|__pycache__/
#|*.py[cod]
# <<< canon baseline
expected_block=$(sed -n '/^# >>> canon baseline$/,/^# <<< canon baseline$/p' "$SCRIPT_PATH" | sed 's/^#|//')
if [ ! -f .gitignore ]; then
  fail_one 'missing required file .gitignore'
else
  actual_block=$(sed -n '/^# >>> canon baseline$/,/^# <<< canon baseline$/p' .gitignore)
  if [ -z "$actual_block" ]; then
    fail_one '.gitignore is missing the canon baseline block and its markers'
  elif [ "$actual_block" = "$expected_block" ]; then
    pass '.gitignore canon baseline block matches'
  else
    fail_one '.gitignore canon baseline block differs from canon'
  fi
fi

# --- Toolchain declaration -----------------------------------------------
if [ "$TYPE" = "application" ] && [ ! -f mise.toml ]; then
  fail_one 'missing required file mise.toml for the application tier'
fi
if [ -f mise.toml ]; then
  if grep -q '^\[tools\]' mise.toml; then
    pass 'mise.toml declares [tools]'
  else
    fail_one 'mise.toml must declare a [tools] section'
  fi
  if [ "$TYPE" = "application" ]; then
    grep -Eq '^node[[:space:]]*=' mise.toml \
      || fail_one 'mise.toml must pin node for the application tier'
    # Only a tracked lock file defines the repository's package manager: a
    # gitignored lock file created by a local install must not change the rule.
    if git ls-files --error-unmatch pnpm-lock.yaml >/dev/null 2>&1; then
      # mise supports both a native backend key and npm-sourced "npm:pnpm".
      grep -Eq '^("?npm:)?pnpm"?[[:space:]]*=' mise.toml \
        || fail_one 'mise.toml must pin pnpm for a tracked pnpm-lock.yaml'
    elif git ls-files --error-unmatch package-lock.json >/dev/null 2>&1; then
      grep -Eq '^("?npm:)?npm"?[[:space:]]*=' mise.toml \
        || fail_one 'mise.toml must pin npm for a tracked package-lock.json'
    fi
  fi
fi

# --- Documentation entry points ------------------------------------------
if [ ! -f README.md ]; then
  fail_one 'missing required file README.md'
else
  grep -q '^# ' README.md || fail_one 'README.md has no top-level heading'
  if grep -q '^## Validation' README.md; then
    pass 'README.md documents validation'
  else
    fail_one 'README.md has no ## Validation section'
  fi
fi

if [ ! -f AGENTS.md ]; then
  fail_one 'missing required file AGENTS.md'
else
  for heading in '# Agent Instructions' '## Scope' '## Working rules' '## Validation'; do
    grep -Fxq "$heading" AGENTS.md || fail_one "AGENTS.md is missing the heading $heading"
  done
  [ "$failures" -eq 0 ] || true
  pass 'AGENTS.md headings present'
fi

# --- Workflows -----------------------------------------------------------
# The baseline workflow is byte-identical everywhere and carries no policy of
# its own; every rule lives in scripts/repository-check, which is also
# byte-identical. Identity is verified through the manifest, so a public
# repository never needs a private canon repository to be reachable from its
# CI, and there is no cross-repository pin to drift.
baseline_workflow=.github/workflows/repository-baseline.yml
if [ ! -f "$baseline_workflow" ]; then
  fail_one "missing required file $baseline_workflow"
fi

for workflow in .github/workflows/*.yml .github/workflows/*.yaml; do
  [ -f "$workflow" ] || continue
  unpinned=$(grep -E '^[[:space:]]*uses:[[:space:]]+[^./][^@[:space:]]+@' "$workflow" \
    | grep -Ev '@[0-9a-fA-F]{40}([[:space:]]|$)' || true)
  if [ -n "$unpinned" ]; then
    fail_one "$workflow contains an unpinned external Action"
  else
    pass "$workflow external Actions are SHA-pinned"
  fi
done

# --- Tracked generated output -------------------------------------------
git ls-files > "$TMP/tracked"
# Patterns are anchored to the repository root so that source directories such
# as scripts/build/ are never mistaken for generated output.
check_tracked() {
  description=$1
  regex=$2
  matches=$(grep -E "$regex" "$TMP/tracked" | head -5 || true)
  if [ -n "$matches" ]; then
    fail_one "tracked generated output ($description): $(printf '%s' "$matches" | tr '\n' ' ')"
  fi
}
check_tracked 'artifacts/' '^artifacts/'
check_tracked 'build/' '^build/'
check_tracked 'coverage/' '^coverage/'
check_tracked 'dist/' '^dist/'
check_tracked 'node_modules/' '(^|/)node_modules/'
check_tracked 'bytecode cache' '(^|/)__pycache__/'
check_tracked 'compiled Python' '\.py[co]$'
check_tracked 'CAD export' '\.(step|stl)$'

# --- Scripts -------------------------------------------------------------
git ls-files -- 'scripts/*' > "$TMP/scripts"
while IFS= read -r script; do
  [ -n "$script" ] || continue
  [ -f "$script" ] || continue
  shebang=$(head -1 "$script" || true)
  case $shebang in
    '#!'*sh*|'#!'*bash*) ;;
    *) continue ;;
  esac

  mode=$(git ls-files -s -- "$script" | awk '{print $1}')
  if [ "$mode" != "100755" ]; then
    fail_one "$script is not executable in Git"
  fi

  case $shebang in
    '#!'*bash*)
      if command -v bash >/dev/null 2>&1; then
        bash -n "$script" || fail_one "$script has a shell syntax error"
      fi ;;
    *)
      sh -n "$script" || fail_one "$script has a shell syntax error" ;;
  esac

  base=$(basename "$script")
  if ! printf '%s' "$base" | grep -Eq '^[a-z0-9]+(-[a-z0-9]+)*(\.sh)?$'; then
    warn_one "$script does not follow the lowercase-hyphen naming convention"
  fi
done < "$TMP/scripts"
[ "$failures" -eq 0 ] || true

# --- Language policy ----------------------------------------------------
# English is authoritative. Chinese mirrors belong under docs/zh-CN/ and must
# point at an existing English source; anything else is phase 2 backlog.
cjk='[\344-\351]'
git ls-files -- 'docs/' > "$TMP/docs"
while IFS= read -r doc; do
  [ -n "$doc" ] || continue
  [ -f "$doc" ] || continue
  case $doc in
    *.md|*.markdown) ;;
    *) continue ;;
  esac
  case $doc in
    docs/zh-CN/*)
      header=$(head -1 "$doc" || true)
      source=$(printf '%s' "$header" | sed -n 's/^<!-- non-authoritative mirror: authoritative source: \(.*\) -->$/\1/p')
      if [ -z "$source" ]; then
        warn_one "$doc is missing the non-authoritative mirror header"
      elif [ ! -f "$source" ]; then
        warn_one "$doc points at a missing authoritative source: $source"
      fi ;;
    *)
      if LC_ALL=C grep -q "$cjk" "$doc"; then
        warn_one "$doc contains Chinese outside docs/zh-CN/ (phase 2 backlog: promote to English)"
      fi ;;
  esac
done < "$TMP/docs"

# --- Result -------------------------------------------------------------
if [ "$failures" -ne 0 ]; then
  printf 'baseline validation failed: %s failure(s), %s warning(s)\n' "$failures" "$warnings"
  exit 1
fi
if [ "$strict" -eq 1 ] && [ "$warnings" -ne 0 ]; then
  printf 'baseline validation failed (strict): %s warning(s)\n' "$warnings"
  exit 1
fi
printf 'baseline validation success: 0 failures, %s warning(s)\n' "$warnings"
